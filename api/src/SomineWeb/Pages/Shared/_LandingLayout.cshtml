@{
    var language = SiteLanguages.Current;
    var alternateLanguage = language == SiteLanguages.English ? SiteLanguages.Default : SiteLanguages.English;

    var title = ViewData["Title"] as string;
    var fullTitle = string.IsNullOrEmpty(title)
        ? L["layout.defaultTitle"].Value
        : $"{title} | {L["layout.titleSuffix"].Value}";
    var description = ViewData["Description"] as string ?? L["layout.defaultDescription"].Value;
    var transparentNav = ViewData["TransparentNav"] as bool? ?? false;
    // Sayfa kendi OG/Twitter etiketlerini @section Head icinde veriyorsa true yapar.
    // Aksi halde asagidaki genel etiketler once render edilir ve scraper'lar ilk gordugunu kullanir.
    var suppressDefaultOg = ViewData["SuppressDefaultOg"] as bool? ?? false;
    // /s/{token} noindex oldugu icin canonical/hreflang yayinlamaz.
    var suppressAlternates = ViewData["SuppressAlternates"] as bool? ?? false;
}
<!DOCTYPE html>
<html lang="@SiteLanguages.HtmlLang(language)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@fullTitle</title>
    <meta name="description" content="@description" />
    @if (!suppressAlternates)
    {
        @* Her dil surumu kendi kanonik adresine sahip; parametresiz adres dil pazarligi yapan x-default. *@
        <link rel="canonical" href="@LanguageUrl.AbsoluteFor(Context.Request, language)" />
        @foreach (var alternate in SiteLanguages.Supported)
        {
            <link rel="alternate" hreflang="@alternate" href="@LanguageUrl.AbsoluteFor(Context.Request, alternate)" />
        }
        <link rel="alternate" hreflang="x-default" href="@LanguageUrl.AbsoluteNeutral(Context.Request)" />
    }
    @if (!suppressDefaultOg)
    {
        <meta property="og:title" content="@fullTitle" />
        <meta property="og:description" content="@description" />
        <meta property="og:type" content="website" />
        <meta property="og:image" content="/images/logo-gradient.png" />
        <meta property="og:locale" content="@SiteLanguages.OpenGraphLocale(language)" />
        <meta property="og:locale:alternate" content="@SiteLanguages.OpenGraphLocale(alternateLanguage)" />
        <meta name="twitter:card" content="summary_large_image" />
    }
    <link rel="icon" href="/images/logo.png" />
    <link rel="apple-touch-icon" href="/images/logo.png" />
    <link rel="manifest" href="/manifest.json" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/swiper/swiper-bundle.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />

    @RenderSection("Head", required: false)

</head>
<body class="antialiased bg-[#688E8B] text-foreground min-h-screen">
    <partial name="_Navbar" model="transparentNav" />

    @RenderBody()

    <partial name="_Footer" />

    <button id="scrollToTop" aria-label="@L["layout.scrollToTop"]"
            class="fixed bottom-6 right-6 z-50 w-11 h-11 rounded-full bg-[#3d5c59] text-white shadow-lg hover:bg-[#2e4542] hover:scale-105 transition-all duration-300 flex items-center justify-center opacity-0 pointer-events-none translate-y-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 15l-6-6-6 6" />
        </svg>
    </button>

    @* Çerez onayı: Google Analytics yalnızca "Kabul et" sonrası yüklenir (varsayılan: reddedilmiş).
       Tercih 6 ay saklanır; gizlilik sayfasındaki bağlantı window.somineCookiePrefs() ile bandı yeniden açar. *@
    @{
        var isEn = language == SiteLanguages.English;
    }
    <div id="cookie-banner" role="dialog" aria-live="polite" aria-label="@(isEn ? "Cookie preferences" : "Çerez tercihleri")"
         style="display:none;position:fixed;left:16px;right:16px;bottom:16px;z-index:60;max-width:560px;margin:0 auto;background:#ffffff;color:#1f2937;border-radius:16px;box-shadow:0 10px 30px rgba(0,0,0,.18);padding:16px 18px;font-size:14px;line-height:1.5;">
        <p style="margin:0 0 12px;">
            @(isEn
                ? "We'd like to use Google Analytics cookies to understand how people use this site. Only with your permission; the site works the same either way."
                : "Sitenin nasıl kullanıldığını anlamak için Google Analytics çerezlerini kullanmak istiyoruz. Yalnızca izninle; site her iki durumda da aynı çalışır.")
            <a href="/privacy@(isEn ? "?lang=en" : "")" style="color:#3d5c59;text-decoration:underline;">@(isEn ? "Privacy policy" : "Gizlilik politikası")</a>
        </p>
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <button type="button" id="cookie-reject" style="flex:1;min-width:120px;min-height:44px;border-radius:12px;border:1px solid #3d5c59;background:#ffffff;color:#3d5c59;font-weight:600;cursor:pointer;">@(isEn ? "Reject" : "Reddet")</button>
            <button type="button" id="cookie-accept" style="flex:1;min-width:120px;min-height:44px;border-radius:12px;border:1px solid #3d5c59;background:#3d5c59;color:#ffffff;font-weight:600;cursor:pointer;">@(isEn ? "Accept" : "Kabul et")</button>
        </div>
    </div>
    <script>
        (function () {
            var KEY = 'somine_cookie_consent';
            var GA_ID = 'G-46BXTGD78L';
            var MAX_AGE = 60 * 60 * 24 * 182; // ~6 ay
            var banner = document.getElementById('cookie-banner');

            function read() {
                var m = document.cookie.match(new RegExp('(?:^|; )' + KEY + '=([^;]*)'));
                return m ? m[1] : null;
            }
            function save(value) {
                document.cookie = KEY + '=' + value + '; Max-Age=' + MAX_AGE + '; Path=/; SameSite=Lax; Secure';
            }
            function loadAnalytics() {
                if (window.__somineGaLoaded) return;
                window.__somineGaLoaded = true;
                window.dataLayer = window.dataLayer || [];
                window.gtag = function () { dataLayer.push(arguments); };
                gtag('js', new Date());
                gtag('config', GA_ID, { anonymize_ip: true });
                var s = document.createElement('script');
                s.async = true;
                s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
                document.head.appendChild(s);
            }
            function clearAnalyticsCookies() {
                document.cookie.split('; ').forEach(function (c) {
                    var name = c.split('=')[0];
                    if (name.indexOf('_ga') === 0) {
                        var host = location.hostname.replace(/^www\./, '');
                        document.cookie = name + '=; Max-Age=0; Path=/';
                        document.cookie = name + '=; Max-Age=0; Path=/; Domain=.' + host;
                    }
                });
            }
            function show() { banner.style.display = 'block'; }
            function hide() { banner.style.display = 'none'; }

            document.getElementById('cookie-accept').addEventListener('click', function () {
                save('granted'); hide(); loadAnalytics();
            });
            document.getElementById('cookie-reject').addEventListener('click', function () {
                save('denied'); hide(); clearAnalyticsCookies();
            });
            window.somineCookiePrefs = show;

            var choice = read();
            if (choice === 'granted') loadAnalytics();
            else if (choice !== 'denied') show();
        })();
    </script>

    <script src="~/lib/swiper/swiper-bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/landing.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
